CURRENCY_NGN_PER_KES=
CURRENCY_NGN_PER_CNY=
CURRENCY_NGN_PER_JPY=
CURRENCY_NGN_PER_INR=
CURRENCY_NGN_PER_AED=
CURRENCY_NGN_PER_SAR=
CURRENCY_NGN_PER_CHF=
CURRENCY_NGN_PER_SEK=
CURRENCY_NGN_PER_NOK=
CURRENCY_NGN_PER_DKK=
