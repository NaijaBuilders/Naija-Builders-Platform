LEGACY_DB_PORT=3306
LEGACY_DB_DATABASE=naijabuilders_legacy
LEGACY_DB_USERNAME=root
LEGACY_DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=1440
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="info@naijabuilders.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

KYC_PROVIDER=fake
KYC_MODE=local
KYC_FACE_MATCH_THRESHOLD=80
PREMBLY_API_KEY=
PREMBLY_BASE_URL=https://api.prembly.com
PREMBLY_WEBHOOK_SECRET=
PREMBLY_TIMEOUT_SECONDS=30
PREMBLY_APP_ID=
PREMBLY_BANK_CUSTOMER_NAME_FIELD=customer_name
PREMBLY_ENDPOINT_EMAIL_COMPANY_SEARCH=/identitypass/verification/global/company/search_with_email
PREMBLY_ENDPOINT_AML_PEP=
DOJAH_BASE_URL=https://sandbox.dojah.example
DOJAH_APP_ID=
