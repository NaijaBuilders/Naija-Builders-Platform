{
  "expo": {
    "name": "NaijaBuilders Mobile",
    "slug": "naijabuilders-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "naijabuilders",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#F4F7FB"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "plugins": [
      "expo-font"
    ]
  }
}
