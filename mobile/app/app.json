{
  "expo": {
    "name": "NaijaBuilders",
    "slug": "naijabuilders-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "naijabuilders",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/images/icon.png",
    "splash": {
      "image": "./assets/images/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#F4F7FB"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#1F4FA3"
      }
    },
    "plugins": [
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow NaijaBuilders to select product photos for supplier listings."
        }
      ]
    ]
  }
}
