{
  "name": "naijabuilders-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "node scripts/expo-cli.js start --tunnel --port 8081",
    "start:lan": "node scripts/expo-cli.js start --host lan --port 8081",
    "start:tunnel": "node scripts/expo-cli.js start --tunnel --port 8081",
    "start:ngrok": "node scripts/expo-cli.js start --tunnel --port 8081",
    "start:localhost": "node scripts/expo-cli.js start --localhost --port 8081",
    "dev:api": "node scripts/dev-api.js",
    "dev:mobile": "node scripts/expo-cli.js start --host lan --port 8081 --clear",
    "dev:mobile:tunnel": "node scripts/expo-cli.js start --tunnel --port 8081 --clear",
    "typecheck": "tsc --noEmit",
    "android": "node scripts/expo-cli.js start --android --host lan --port 8081",
    "ios": "node scripts/expo-cli.js start --ios --host lan --port 8081",
    "web": "node scripts/expo-cli.js start --web --port 8081"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.15.11",
    "@react-navigation/native": "^7.2.2",
    "@react-navigation/native-stack": "^7.14.12",
    "axios": "^1.16.0",
    "expo": "^54.0.34",
    "expo-blur": "~15.0.8",
    "expo-font": "~14.0.11",
    "expo-image-picker": "~17.0.11",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.1.10",
    "babel-preset-expo": "~54.0.10",
    "typescript": "~5.9.2"
  }
}
